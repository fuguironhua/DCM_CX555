#include "resource.h"
#include "afxres.h"
#pragma code_page(65001)
LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED

IDD_TLBB_MULTI_OPEN DIALOGEX 0, 0, 330, 185
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "多开"
FONT 9, "MS Shell Dlg"
BEGIN
    LTEXT "游戏目录", IDC_STATIC, 8, 10, 40, 12
    EDITTEXT IDC_EDIT_TLBB_ROOT, 50, 8, 225, 15, ES_AUTOHSCROLL
    PUSHBUTTON "浏览", IDC_BUTTON_TLBB_BROWSE, 280, 8, 42, 16
    LTEXT "多开上限", IDC_STATIC, 8, 36, 40, 12
    EDITTEXT IDC_EDIT_TLBB_LIMIT, 50, 33, 35, 15, ES_NUMBER
    CONTROL "", IDC_SPIN_TLBB_LIMIT, "msctls_updown32", UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_SETBUDDYINT | UDS_ARROWKEYS, 75, 33, 10, 15
    LTEXT "当前客户端：0", IDC_STATIC_TLBB_COUNT, 100, 36, 120, 12
    PUSHBUTTON "刷新", IDC_BUTTON_TLBB_REFRESH, 280, 33, 42, 16
    EDITTEXT IDC_EDIT_TLBB_LOG, 8, 57, 314, 92, ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL
    PUSHBUTTON "启动一个客户端", IDC_BUTTON_TLBB_START, 158, 158, 98, 20
    PUSHBUTTON "关闭", IDCANCEL, 264, 158, 58, 20
END
